{
  "//": "Shared by apps: \"extends\": \"vuenative/tsconfig.base.json\". 'vue' is vuenative's renderer.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "vue": ["./src/renderer.ts"],
      "vuenative/router": ["./src/router.ts"]
    }
  }
}
