<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light or dark with the system: values-night/styles.xml has the dark ones. -->
    <style name="AppTheme.Base" parent="@android:style/Theme.Material.Light.NoActionBar" />
    <bool name="light_system_bars">true</bool>
    <color name="splash_background">#FFFFFF</color>

    <!-- Status and navigation bar icons that contrast with the screens. The splash screen (Android
         12+) matches the iOS launch screen: the logo, 120dp, on white, or on ink in dark mode. -->
    <style name="AppTheme" parent="AppTheme.Base">
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_logo</item>
    </style>
</resources>
