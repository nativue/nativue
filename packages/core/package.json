{
  "name": "@nativue/core",
  "version": "0.8.0",
  "description": "Vue rendering real native views on iOS and Android",
  "keywords": [
    "vue",
    "native",
    "ios",
    "android",
    "mobile",
    "renderer"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nativue/nativue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nativue/nativue.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/nativue/nativue/issues",
  "type": "module",
  "bin": {
    "nativue": "cli/nativue.mjs"
  },
  "exports": {
    ".": "./src/renderer.ts",
    "./router": "./src/router.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./config": {
      "types": "./cli/config.d.mts",
      "default": "./cli/config.mjs"
    }
  },
  "scripts": {
    "test": "(cd ../../examples/demo && nativue build) && node test/test.mjs",
    "typecheck": "vue-tsc"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/runtime-core": "^3.5.45",
    "hermes-compiler": "260318099.0.8",
    "vite": "^8.3.8",
    "vue": "^3.5.45",
    "whatwg-fetch": "^3.6.20"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.14"
  },
  "files": [
    "src",
    "cli",
    "ios",
    "Package.swift",
    "tsconfig.base.json",
    "android/build.gradle.kts",
    "android/consumer-rules.pro",
    "android/nativue.settings.gradle.kts",
    "android/src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
