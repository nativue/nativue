{
  "name": "@nativue/share",
  "version": "0.1.0",
  "description": "Share text, links, photos, videos and files from nativue apps",
  "keywords": [
    "vue",
    "native",
    "share",
    "share-sheet",
    "nativue"
  ],
  "license": "MIT",
  "homepage": "https://github.com/nativue/nativue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nativue/nativue.git",
    "directory": "packages/share"
  },
  "bugs": "https://github.com/nativue/nativue/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "vue-tsc"
  },
  "peerDependencies": {
    "@nativue/core": ">=0.18.0"
  },
  "nativue": {
    "ios": {
      "sources": "ios",
      "plugin": "SharePlugin"
    },
    "android": {
      "sources": "android",
      "plugin": "dev.nativue.share.SharePlugin"
    }
  },
  "files": [
    "src",
    "ios",
    "android/build.gradle.kts",
    "android/src"
  ],
  "publishConfig": {
    "access": "public"
  }
}
