{
  "name": "nativue-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "build": "npm run build -w demo",
    "test": "npm test -w @nativue/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write packages examples"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  }
}
