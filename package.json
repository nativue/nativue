{
  "name": "nativue-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "dev": "npm run dev -w demo",
    "ios": "npm run ios -w demo",
    "android": "npm run android -w demo",
    "build": "npm run build -w demo",
    "test": "npm test -w @nativue/core -w @nativue/tailwind -w @nativue/sqlite",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "format": "prettier --write packages examples"
  },
  "devDependencies": {
    "prettier": "^3.10.1",
    "typescript": "^6.0.3"
  }
}
